# Theos build artefacts
.theos/
*.theos-test
obj/

# macOS
.DS_Store
**/.DS_Store

# Editors
.vscode/
.idea/
*.swp
*~

# Build outputs (the .ipa goes into a GitHub Release, not the repo)
*.ipa
!docs/debs/*.ipa
packages/
build-temp/

# Local Python (catalog rebuild scripts elsewhere)
__pycache__/
*.pyc

# Logs / debug
*.log
/tmp/

# Cloudflare Worker — deployed by pasting into the Cloudflare dashboard, never from the repo
# (and it must never carry secrets). Translation job DB stays local too.
feedback-worker/
work.db

# Personal notes that don't belong in the public repo
PROGRESS.md
IPA-Install-RAPPORT.md
deps/mbedtls/
!deps/build/
!deps/build/*.a
desc_work/

# Catalog build artifacts — the catalog is downloaded at runtime (catalog.db.gz on
# GitHub Pages), never committed to the source repo.
IPAInstaller/catalog.db
IPAInstaller/catalog-build/
